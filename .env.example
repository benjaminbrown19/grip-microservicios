# Copiar como .env (en EC2) y reemplazar los valores. NUNCA subir .env a GitHub.
# Usar solo letras y numeros en las claves.

# Puerto publico del API Gateway (el frontend usa http://IP_PUBLICA:8080/api/v1).
GATEWAY_PORT=8080

# Base de datos.
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT
GRIP_DB_PASSWORD=CAMBIAR_CLAVE_APP

# Clave para firmar y validar JWT (32 caracteres o mas). La MISMA para los tres servicios.
GRIP_JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_32_O_MAS

# Cuentas iniciales ana.perez@duoc.cl y carlos.soto@duoc.cl (minimo 8 caracteres).
GRIP_ADMIN_PASSWORD=CAMBIAR8
GRIP_VENDEDOR_PASSWORD=CAMBIAR8

# Origenes permitidos por CORS (opcional; separados por coma).
# GRIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
